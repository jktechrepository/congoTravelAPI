{
  "info": {
    "name": "CongoTravel API",
    "description": "Collection complète des endpoints de l'API CongoTravel avec système RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7105/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Se Connecter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Sauvegarder le token automatiquement",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.environment.set('accessToken', jsonData.accessToken);",
                  "    console.log('Token sauvegardé:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOuTelephone\": \"+243999999999\",\n  \"motDePasse\": \"Super-Admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/Utilisateur/authentifier",
              "host": ["{{baseUrl}}"],
              "path": ["Utilisateur", "authentifier"]
            }
          },
          "response": []
        },
        {
          "name": "Changer Mot de Passe",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idUtilisateur\": 1,\n  \"ancienMotDePasse\": \"Super-Admin\",\n  \"nouveauMotDePasse\": \"NewPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/Utilisateur/changer-mot-de-passe",
