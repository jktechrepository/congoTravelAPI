# ═══════════════════════════════════════════════════════════════════
# 🔐 SECRETS - Template pour variables d'environnement
# ═══════════════════════════════════════════════════════════════════
# ⚠️ NE JAMAIS commiter le fichier .env réel avec les valeurs
# ⚠️ Copier ce fichier vers .env et remplir avec les vraies valeurs
# 
# Instructions :
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir les valeurs dans .env (NE PAS commiter .env)
# 3. Les valeurs avec "CHANGEZ_MOI" doivent être remplacées
# 4. Les valeurs avec "GENERER_..." doivent être générées

# ──────────────────────────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=3306
DB_DATABASE=knb_db
DB_USER=kansa
DB_PASSWORD=CHANGEZ_MOI

# ──────────────────────────────────────────────────────────────────
# JWT (JSON Web Tokens)
# ──────────────────────────────────────────────────────────────────
# ⚠️ IMPORTANT : Générer une clé aléatoire de 256 bits minimum
# Commande pour générer : openssl rand -base64 32
# OU PowerShell : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET_KEY=GENERER_UNE_CLE_ALEATOIRE_DE_256_BITS_MINIMUM
JWT_ISSUER=KelasiNaBisoAPI
JWT_AUDIENCE=KelasiNaBisoClient
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ──────────────────────────────────────────────────────────────────
# TWILIO (SMS)
# ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGEZ_MOI
TWILIO_AUTH_TOKEN=CHANGEZ_MOI
TWILIO_PHONE_NUMBER=+16203038641
TWILIO_SENDER_ID=CHANGEZ_MOI
TWILIO_PRIX_PAR_SMS=0.0467
TWILIO_ENABLED=true

# ──────────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ──────────────────────────────────────────────────────────────────
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=kelasinabiso@gmail.com
EMAIL_PASSWORD=CHANGEZ_MOI
EMAIL_SENDER_NAME=KelasiNaBiso Platform

# ──────────────────────────────────────────────────────────────────
# FIREBASE (Notifications Push)
# ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=kelasinabiso-de502
FIREBASE_SENDER_ID=1018914946705
FIREBASE_API_KEY=CHANGEZ_MOI
